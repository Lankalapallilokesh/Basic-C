#include<stdio.h>
int main()
{
	int a[20],b[20],temp,i,n;
	printf("enter elements");
	scanf("%d",&n);
	printf("enter %d elements",n);
	for(i=0;i<n;i++)
	scanf("%d",&a[i]);
	printf("enter %d elements",n);
	for(i=0;i<n;i++)
	scanf("%d",&b[i]);
	for(i=0;i<n;i++)
	{
	temp=a[i];
	a[i]=b[i];
	b[i]=temp;
	}
	printf("\nafter swapping two arrays:\n");
	printf("array a");
	for(i=0;i<n;i++)
	printf("%d",a[i]);
	
	printf("\narray  b");
	for(i=0;i<n;i++)
	printf("%d",b[i]);   
}
