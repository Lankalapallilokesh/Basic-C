#include<stdio.h>
#include<string.h>
int main()
{
	char s[20][25],temp[25];
	int i,j,n;
	printf("enter number of strings");
	scanf("%d",&n);
	printf("enter %d string are",n);
	for(i=0;i<n;i++)
	scanf("%s",&s[i]);
	printf("before sortting strings\n");
	for(i=0;i<n;i++)
	printf("%s\n",s[i]);
	for(i=0;i<n-1;i++)
		{
			for(j=i+1;j<n;j++)
			{
				if(strcmp(s[i],s[j])>0)
				{
					strcpy(temp,s[i]);
					strcpy(s[i],s[j]);
					strcpy(s[j],temp);
				}
		    }
		}
		printf("after sortting string\n");
		for(i=0;i<n;i++)
		printf("%s\n",s[i]);
			
}
